# --- Supabase (gratuit) — conturi + programări persistente ---
# 1. Creează proiect pe https://supabase.com
# 2. Rulează SQL din supabase/schema.sql (SQL Editor)
# 3. Copiază Project URL + anon public key din Settings → API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- EmailJS (gratuit) — OBLIGATORIU pentru emailuri reale ---
# 1. Cont pe https://www.emailjs.com → Email Services → Add (Gmail)
# 2. Email Templates → New
# 3. În template, câmpul "To Email" = {{to_email}}   ← important!
# 4. Copiază ID-urile aici, salvează, apoi: npm run dev (restart)
#
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
# Opțional (dacă EmailJS cere Private Key):
# VITE_EMAILJS_PRIVATE_KEY=

# Template OTP reset: {{to_email}} {{user_name}} {{otp_code}} {{salon_name}}
VITE_EMAILJS_TEMPLATE_ID=

# Template confirmare programare (recomandat separat):
# To Email = {{to_email}}
# Body: {{client_name}} {{services}} {{date}} {{time}} {{staff}}
#       {{salon_name}} {{salon_phone}} {{salon_address}}
VITE_EMAILJS_BOOKING_TEMPLATE_ID=
